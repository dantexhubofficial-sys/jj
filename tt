local function CreateAnimatedBackground(parent)
    local bgContainer = Instance.new("Frame")
    bgContainer.Size = UDim2.new(1, 0, 1, 0)
    bgContainer.BackgroundTransparency = 1
    bgContainer.ClipsDescendants = true
    bgContainer.ZIndex = 0
    bgContainer.Parent = parent

    local particles = {}

    for i = 1, 40 do
        local dot = Instance.new("Frame")
        dot.Size = UDim2.new(0, math.random(2, 6), 0, math.random(2, 6))
        dot.Position = UDim2.new(0, math.random(0, 650), 0, math.random(0, 700))
        dot.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        dot.BackgroundTransparency = math.random(0.3, 0.7)
        dot.BorderSizePixel = 0
        dot.ZIndex = 0
        dot.Parent = bgContainer

        local dotCorner = Instance.new("UICorner")
        dotCorner.CornerRadius = UDim.new(1, 0)
        dotCorner.Parent = dot

        particles[i] = {
            obj = dot,
            speed = math.random(15, 60),
            direction = math.random(0, 1) == 0 and -1 or 1,
            amplitude = math.random(10, 40),
            baseX = math.random(0, 650),
            baseY = math.random(0, 700)
        }
    end

    for i = 1, 8 do
        local line = Instance.new("Frame")
        line.Size = UDim2.new(0, math.random(30, 80), 0, 1)
        line.Position = UDim2.new(0, math.random(0, 650), 0, math.random(0, 700))
        line.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        line.BackgroundTransparency = 0.6
        line.BorderSizePixel = 0
        line.ZIndex = 0
        line.Parent = bgContainer

        particles["line" .. i] = {
            obj = line,
            speed = math.random(20, 70),
            direction = math.random(0, 1) == 0 and -1 or 1,
            amplitude = math.random(15, 60),
            baseX = math.random(0, 650),
            baseY = math.random(0, 700)
        }
    end

    RunService.RenderStepped:Connect(function(dt)
        for _, p in pairs(particles) do
            local pos = p.obj.Position
            local newY = pos.Y.Offset + p.speed * p.direction * dt
            local newX = p.baseX + math.sin(os.clock() * p.direction + p.baseX) * p.amplitude

            if newY < -10 then
                newY = 710
            elseif newY > 710 then
                newY = -10
            end

            p.obj.Position = UDim2.new(0, newX, 0, newY)
        end
    end)
end

CreateAnimatedBackground(MainFrame)

local function MakeDraggable(frame, dragHandle)
    local dragging = false
    local dragStart = nil
    local startPos = nil

    dragHandle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position
        end
    end)

    dragHandle.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseMovement) then
            local delta = input.Position - dragStart
            local newX = startPos.X.Offset + delta.X
            local newY = startPos.Y.Offset + delta.Y

            newX = math.clamp(newX, -frame.AbsoluteSize.X + 100, Camera.ViewportSize.X - 100)
            newY = math.clamp(newY, 0, Camera.ViewportSize.Y - 100)

            frame.Position = UDim2.new(0, newX, 0, newY)
        end
    end)

    dragHandle.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)
end

local function MakeScrollable(scrollFrame)
    local scrollSpeed = 40
    local isTouching = false
    local lastTouchY = nil

    scrollFrame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch then
            isTouching = true
            lastTouchY = input.Position.Y
        end
    end)

    scrollFrame.InputChanged:Connect(function(input)
        if isTouching and input.UserInputType == Enum.UserInputType.Touch then
            local deltaY = input.Position.Y - lastTouchY
            lastTouchY = input.Position.Y
            scrollFrame.CanvasPosition = Vector2.new(scrollFrame.CanvasPosition.X, math.clamp(scrollFrame.CanvasPosition.Y - deltaY, 0, math.max(0, scrollFrame.AbsoluteCanvasSize.Y - scrollFrame.AbsoluteSize.Y)))
        end
    end)

    scrollFrame.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch then
            isTouching = false
        end
    end)
end

