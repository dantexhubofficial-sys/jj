local ESPEnabled = false
local AimBotEnabled = false
local ESPObjects = {}

local function IsEnemy(player)
    if not EspSettings.TeamCheck then
        return true
    end
    
    local localTeam = LocalPlayer.Team
    local playerTeam = player.Team
    
    if localTeam and playerTeam then
        return localTeam ~= playerTeam
    end
    
    return true
end

local function CreateESP(player)
    local highlight = Instance.new("Highlight")
    highlight.Name = "ESP_" .. player.Name
    highlight.FillColor = Color3.fromRGB(255, 0, 0)
    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
    highlight.FillTransparency = 0.5
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Enabled = false
    highlight.Parent = nil

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "Billboard_" .. player.Name
    billboard.Size = UDim2.new(0, 100, 0, 60)
    billboard.StudsOffset = Vector3.new(0, 3, 0)
    billboard.AlwaysOnTop = true
    billboard.Enabled = false

    local nameLabel = Instance.new("TextLabel")
    nameLabel.Name = "NameLabel"
    nameLabel.Size = UDim2.new(1, 0, 0, 20)
    nameLabel.BackgroundTransparency = 1
    nameLabel.Text = player.Name
    nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    nameLabel.Font = Enum.Font.GothamBold
    nameLabel.TextSize = 14
    nameLabel.TextStrokeTransparency = 0
    nameLabel.Parent = billboard

    local hpLabel = Instance.new("TextLabel")
    hpLabel.Name = "HpLabel"
    hpLabel.Size = UDim2.new(1, 0, 0, 20)
    hpLabel.Position = UDim2.new(0, 0, 0, 20)
    hpLabel.BackgroundTransparency = 1
    hpLabel.Text = "HP: 100"
    hpLabel.TextColor3 = Color3.fromRGB(0, 255, 0)
    hpLabel.Font = Enum.Font.Gotham
    hpLabel.TextSize = 12
    hpLabel.TextStrokeTransparency = 0
    hpLabel.Parent = billboard

    local distLabel = Instance.new("TextLabel")
    distLabel.Name = "DistLabel"
    distLabel.Size = UDim2.new(1, 0, 0, 20)
    distLabel.Position = UDim2.new(0, 0, 0, 40)
    distLabel.BackgroundTransparency = 1
    distLabel.Text = "Dist: 0"
    distLabel.TextColor3 = Color3.fromRGB(0, 255, 0)
    distLabel.Font = Enum.Font.Gotham
    distLabel.TextSize = 12
    distLabel.TextStrokeTransparency = 0
    distLabel.Parent = billboard

    ESPObjects[player] = {
        highlight = highlight,
        billboard = billboard
    }
end

local function UpdateESP()
    for player, data in pairs(ESPObjects) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") and player.Character:FindFirstChild("Humanoid") then
            local root = player.Character.HumanoidRootPart
            local humanoid = player.Character.Humanoid
            
            local isEnemy = IsEnemy(player)

            data.highlight.Parent = player.Character
            data.highlight.Enabled = ESPEnabled and EspSettings.Backlight and isEnemy

            data.billboard.Parent = player.Character
            data.billboard.Enabled = ESPEnabled and isEnemy
            data.billboard.Adornee = root

            local nameLabel = data.billboard:FindFirstChild("NameLabel")
            local hpLabel = data.billboard:FindFirstChild("HpLabel")
            local distLabel = data.billboard:FindFirstChild("DistLabel")

            if nameLabel then
                nameLabel.Visible = ESPEnabled and EspSettings.Name and isEnemy
            end

            if hpLabel then
                hpLabel.Visible = ESPEnabled and EspSettings.Hp and isEnemy
                hpLabel.Text = "HP: " .. math.floor(humanoid.Health)
            end

            if distLabel then
                distLabel.Visible = ESPEnabled and EspSettings.Distance and isEnemy
                local localRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                if localRoot then
                    local dist = (root.Position - localRoot.Position).Magnitude
                    distLabel.Text = "Dist: " .. math.floor(dist)
                end
            end

            if not EspSettings.Name and not EspSettings.Hp and not EspSettings.Distance then
                data.billboard.Enabled = false
            end
        end
    end
end

ESPButton.MouseButton1Click:Connect(function()
