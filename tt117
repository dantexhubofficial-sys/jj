    AimBotEnabled = not AimBotEnabled
    AimBotButton.TextColor3 = AimBotEnabled and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(255, 0, 0)
    AimBotButton.Text = AimBotEnabled and "AimBot ON" or "AimBot"
end)

for _, player in pairs(Players:GetPlayers()) do
    if player ~= LocalPlayer then
        CreateESP(player)
    end
end

