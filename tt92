    line.ZIndex = 0
    line.Parent = bgContainer

    particles["line" .. i] = {
        obj = line,
        speed = math.random(15, 40),
        direction = math.random(0, 1) == 0 and -1 or 1,
        amplitude = math.random(10, 30),
        baseX = math.random(0, 380),
